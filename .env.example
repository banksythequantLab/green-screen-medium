# Green Screen Medium publisher: environment variable NAMES only.
# Copy to a private, git-ignored file or set the variables in your shell.
# Never put a credential, an API key or a Binding_Variable value in a file
# that is committed.

# --- Mainframe (read by the Connector) ---
# Host name or address of the tn3270 host.
GS_HOST=
# tn3270 port of the host.
GS_PORT=
# Path to the s3270 or ws3270 binary.
GS_S3270_BINARY=

# --- Where the Publisher listens ---
# Listen address (default 127.0.0.1). Do not expose the Publisher publicly.
GS_PUBLISH_HOST=
# Listen port, 1 to 65535 (default 8080).
GS_PUBLISH_PORT=
# http or stdio (default http).
GS_TRANSPORT=

# --- Access ---
# API key, at least 16 characters, required for http. Set it in the shell,
# never in a committed file. Ignored for stdio.
GS_API_KEY=
# true turns the key check off; only allowed on a loopback GS_PUBLISH_HOST.
GS_AUTH_DISABLED=

# --- Limits ---
# Calls in flight at once, 1 to 64 (default 1: one TSO session per user id).
GS_MAX_CONCURRENCY=
# Seconds per call, 1 to 900 (default 180).
GS_CALL_TIMEOUT=
# Largest request body in bytes, 1024 to 1048576 (default 65536).
GS_MAX_BODY_BYTES=
# Seconds to wait for calls in flight on shutdown, 1 to 120 (default 10).
GS_SHUTDOWN_GRACE=

# --- Flows ---
# Extra directory of *.yaml Flows, loaded after the bundled Flows.
GS_FLOWS_DIR=
# Comma-separated Flow names to publish. Unset or empty publishes every
# Loaded_Flow. The demo sets it to tk5-system-info, because tk5-logon leaves
# the user id logged on and locked.
GS_PUBLISH_FLOWS=
# true serves the interactive /docs page (default false).
GS_ENABLE_DOCS=
# true serves the web console at / (HTTP transport only, default false).
GS_ENABLE_CONSOLE=

# --- Bound inputs ---
# GS_BIND_<flow>__<input> supplies one Input of one Flow from the environment
# (see Requirement 22 of the publisher spec for the name rules). The caller can
# then not supply that Input.
# Set these in the shell only; list none here with a value.

# --- Ask (optional AI question box; POST /ask) ---
# true turns Ask on (HTTP transport only, default false). Every GS_LLM_* and GS_ASK_* line below is ignored while it is off.
GS_ENABLE_ASK=
# Base URL of an OpenAI-compatible chat API, required when Ask is on; https, or http only for 127.0.0.1, ::1 or localhost.
GS_LLM_BASE_URL=
# Model name, required when Ask is on (1 to 100 characters from A-Za-z0-9._:/@-).
GS_LLM_MODEL=
# API key for the model provider; required unless the base URL host is loopback. Set it in the shell only.
GS_LLM_API_KEY=
# Optional reasoning effort sent to the model: none, minimal, low, medium or high. Unset means it is not sent.
GS_LLM_REASONING_EFFORT=
# Most tool calls per question, 1 to 20 (default 6).
GS_ASK_MAX_TOOL_CALLS=
# Most model turns per question, 1 to 30 (default 8).
GS_ASK_MAX_TURNS=
# Seconds per question, 20 to 95 (default 90).
GS_ASK_TIMEOUT_SECONDS=
# Seconds per model turn, 1 to 60 (default 25); twice this must not exceed GS_ASK_TIMEOUT_SECONDS.
GS_ASK_MODEL_TIMEOUT_SECONDS=
# Comma-separated Flow names the model may use. Unset or empty offers every eligible published Flow.
GS_ASK_FLOWS=
# Longest question in characters, 1 to 2000 (default 500).
GS_ASK_MAX_QUESTION_CHARS=
# Longest answer in characters, 100 to 20000 (default 2000).
GS_ASK_MAX_ANSWER_CHARS=
# Largest tool result shown to the model in characters, 200 to 20000 (default 4000).
GS_ASK_MAX_RESULT_CHARS=
# Questions per UTC day, 1 to 100000 (default 100).
GS_ASK_DAILY_LIMIT=
# With Ask on and the defaults, GS_CALL_TIMEOUT must be 30 or less (30 recommended); 31 or more stops the start.
